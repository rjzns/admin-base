&НаКлиенте
Процедура СоздатьВоВнешнейБазе(Команда)
	СоздатьПользователейВоВнешнейБазеНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьПользователейВоВнешнейБазеНаСервере()
	
	Для каждого Стр Из ТаблицаПользователей Цикл
		
		Если НЕ Стр.Добавить Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ИдентификаторПользователяИБ) Тогда
			Продолжить; 
		КонецЕсли;
		
		СоздатьОдногоПользователяВоВнешнейБазе(Стр);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОдногоПользователяВоВнешнейБазе(Стр)
	
	Попытка
		
		Соединение = Обработки.ЗагрузкаДанныхИзБазы1С.ПолучитьСоединениеСБазой(ИнформационнаяБаза);
		Если Соединение = Неопределено Тогда
			Сообщить("Не удалось подключиться к базе: " + ИнформационнаяБаза);
			Возврат;
		КонецЕсли;
		
				ПользовательИБ = Соединение.Пользователи.СоздатьПользователяИБ();
		ПользовательИБ.Имя           = Стр.Имя;                    // или Login
		ПользовательИБ.ПолноеИмя     = Стр.Наименование;
		ПользовательИБ.АутентификацияСтандартная = Истина;
		
		Если ЗначениеЗаполнено(Стр.Пароль) Тогда
			ПользовательИБ.Пароль = Стр.Пароль;
		КонецЕсли;
		
		ПользовательИБ.Записать();
		
		
		ОбновитьРеквизитыПользователяИБ(Стр, ПользовательИБ.УникальныйИдентификатор);
		
		Стр.Добавить = Ложь;
		Сообщить("Создан пользователь: " + Стр.Наименование);
		
	Исключение
		Сообщить("Ошибка создания пользователя " + Стр.Наименование + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыПользователяИБ(Стр, НовыйИдентификатор)
	
	ОбъектСпр = Стр.ПользовательИБСсылка.ПолучитьОбъект();
	ОбъектСпр.ИдентификаторПользователяИБ = НовыйИдентификатор;
	ОбъектСпр.Записать();
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВоВнешнейБазе(Команда)
	ОбновитьПользователейВоВнешнейБазеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПользователейВоВнешнейБазеНаСервере()
	Для каждого Стр Из ТаблицаПользователей Цикл
		Если НЕ Стр.Добавить Тогда Продолжить; КонецЕсли;
		ОбновитьОдногоПользователяВоВнешнейБазе(Стр);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьОдногоПользователяВоВнешнейБазе(Стр)
	Попытка
		Соединение = Обработки.ЗагрузкаДанныхИзБазы1С.ПолучитьСоединениеСБазой(ИнформационнаяБаза);
		ПользовательИБ = Соединение.Пользователи.НайтиПоИмени(Стр.Имя);
		
		Если ПользовательИБ <> Неопределено Тогда
			ПользовательИБ.ПолноеИмя = Стр.Наименование; 
			ПользовательИБ.Записать();
			Сообщить("Обновлён: " + Стр.Наименование);
		КонецЕсли;
	Исключение
		Сообщить("Ошибка обновления " + Стр.Наименование);
	КонецПопытки;
КонецПроцедуры    

&НаКлиенте
Процедура УдалитьВоВнешнейБазе(Команда)
	
	Если ТаблицаПользователей.НайтиСтроки(Новый Структура("Добавить", Истина)).Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одного пользователя для удаления.");
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьВоВнешнейБазеПослеВопроса", ЭтотОбъект),
		"Вы действительно хотите удалить выбранных пользователей из внешней базы?" + Символы.ПС +
		"Операция необратима!", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВоВнешнейБазеПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьПользователейВоВнешнейБазеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПользователейВоВнешнейБазеНаСервере()
	
	Для каждого Стр Из ТаблицаПользователей Цикл
		
		Если НЕ Стр.Добавить Тогда
			Продолжить;
		КонецЕсли;
		
		УдалитьОдногоПользователяВоВнешнейБазе(Стр);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОдногоПользователяВоВнешнейБазе(Стр)
	
	Попытка
		Соединение = Обработки.ЗагрузкаДанныхИзБазы1С.ПолучитьСоединениеСБазой(ИнформационнаяБаза);
		Если Соединение = Неопределено Тогда
			Сообщить("Не удалось подключиться к базе для пользователя: " + Стр.Наименование);
			Возврат;
		КонецЕсли;
		
		// Ищем пользователя по имени
		ПользовательИБ = Соединение.Пользователи.НайтиПоИмени(Стр.Имя); // или по другому полю
		
		Если ПользовательИБ <> Неопределено Тогда
			ПользовательИБ.Удалить();
			Сообщить("Удалён пользователь: " + Стр.Наименование);
			
			// Очищаем идентификатор в нашей базе
			Если ЗначениеЗаполнено(Стр.ПользовательИБСсылка) Тогда
				ОбъектСпр = Стр.ПользовательИБСсылка.ПолучитьОбъект();
				ОбъектСпр.ИдентификаторПользователяИБ = "";
				ОбъектСпр.Записать();
			КонецЕсли;
			
		Иначе
			Сообщить("Пользователь " + Стр.Наименование + " не найден во внешней базе.");
		КонецЕсли;
		
	Исключение
		Сообщить("Ошибка удаления пользователя " + Стр.Наименование + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
