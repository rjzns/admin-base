&НаСервере
Процедура СоздатьФизическиеЛицаНаСервере()
	
	Для каждого Стр Из ТаблицаФизическиеЛица Цикл
		//будем создавать только отмеченнных
		Если НЕ Стр.Добавить Тогда
			Продолжить;
		КонецЕсли;     
		//и только если пользователя еще нет в базе
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицоСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		
		
		ссылкаФЛ	 = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.УИД));
		
		Если Найти(Строка(ссылкаФЛ), "<Объект не найден>") > 0 Тогда
			новФЛ = Справочники.ФизическиеЛица.СоздатьЭлемент();
            ЗаполнитьЗначенияСвойств(новФЛ, Стр);
			новФЛ.УстановитьСсылкуНового(ссылкаФЛ);
			новФЛ.Записать();                               
			
		    ссылкаФЛ = новФЛ.Ссылка;
			Если ссылкаФЛ <> Неопределено Тогда
				Стр.Добавить = Ложь;
				Стр.ФизическоеЛицоСсылка = ссылкаФЛ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

