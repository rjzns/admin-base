
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
//	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
//		
//	КонецЕсли;
	
	Если Параметры.Свойство("ИнформационнаяБаза") Тогда
		ИнформационнаяБаза = Параметры.ИнформационнаяБаза;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПользователейИзБазыНаСервере()
	
	ТаблицаПользователей.Очистить();
	
	АдресХранилищаТабПользователи = ПоместитьВоВременноеХранилище(ТаблицаПользователей.Выгрузить());
	
	Обработки.ЗагрузкаДанныхИзБазы1С.ЗагрузитьПользователейИзБазы1С(ИнформационнаяБаза, АдресХранилищаТабПользователи);	
	
	ТабПользователи = ПолучитьИзВременногоХранилища(АдресХранилищаТабПользователи);
    ТаблицаПользователей.Загрузить(ТабПользователи);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПользователейИзБазы(Команда)
	ЗагрузитьПользователейИзБазыНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьПользователейНаСервере()
	
	структПользователь = Новый Структура();
	структПользователь.Вставить("Наименование", "");
	структПользователь.Вставить("ФизическоеЛицо", "");
	структПользователь.Вставить("ИД", "");
	
	Для каждого Стр Из ТаблицаПользователей Цикл
		//будем создавать только отмеченнных
		Если НЕ Стр.Добавить Тогда
			Продолжить;
		КонецЕсли;     
		//и только если пользователя еще нет в базе
		Если ЗначениеЗаполнено(Стр.ПользовательИБСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(структПользователь, Стр);
		текПользователь = СоздатьПользователяИБ(Стр);
		
		Если текПользователь <> Неопределено Тогда
			Стр.Добавить = Ложь;
			Стр.ПользовательИБСсылка = текПользователь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СоздатьПользователяИБ(структПользователь)
	
	ссылкаПользовательИБ	 = Справочники.ПользователиИБ.ПолучитьСсылку(Новый УникальныйИдентификатор(структПользователь.УИД));
	 
	Если ссылкаПользовательИБ = Справочники.ПользователиИБ.ПустаяСсылка() Тогда
		
		новПользовательИБ		 = Справочники.ПользователиИБ.СоздатьЭлемент();
		
		новПользовательИБ.УстановитьСсылкуНового(ссылкаПользовательИБ);
		новПользовательИБ.Наименование					 = структПользователь.Наименование;
		новПользовательИБ.ИдентификаторПользователяИБ	 = структПользователь.ИдентификаторПользователяИБ;
		новПользовательИБ.ИнформационнаяБаза			 = ИнформационнаяБаза;
		новПользовательИБ.Записать();
		
		ссылкаПользовательИБ = новПользовательИБ.Ссылка;
	КонецЕсли;
	
	Возврат ссылкаПользовательИБ;
	
КонецФункции

&НаКлиенте
Процедура СоздатьПользователей(Команда)
	СоздатьПользователейНаСервере();
КонецПроцедуры

