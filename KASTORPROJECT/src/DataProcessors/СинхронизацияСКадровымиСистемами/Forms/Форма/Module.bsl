&НаСервере
Процедура ЗагрузитьСотрудниковНаСервере()

    ТаблицаПользователей.Очистить();

    Выборка = Справочники.Сотрудники.Выбрать();

    Пока Выборка.Следующий() Цикл

        НоваяСтрока = ТаблицаПользователей.Добавить();

        НоваяСтрока.Добавить         = Ложь;
        НоваяСтрока.Сотрудник        = Выборка.Ссылка;
        НоваяСтрока.ЛогинAD          = Выборка.ЛогинAD;
        НоваяСтрока.Должность        = Выборка.Должность;
        НоваяСтрока.Подразделение    = Выборка.Подразделение;
        НоваяСтрока.Статус           = Выборка.Статус;
        НоваяСтрока.Уволен           = Выборка.Уволен;
        НоваяСтрока.ФизическоеЛицо   = Выборка.ФизическоеЛицо;

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСотрудников(Команда)

    ЗагрузитьСотрудниковНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)

    Для каждого Стр Из ТаблицаПользователей Цикл
        Стр.Добавить = Истина;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсе(Команда)

    Для каждого Стр Из ТаблицаПользователей Цикл
        Стр.Добавить = Ложь;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьAD(Команда)

    СинхронизироватьADНаСервере();

    ЗагрузитьСотрудниковНаСервере();

    Сообщить("Синхронизация завершена");

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьADНаСервере()

    Для каждого Стр Из ТаблицаПользователей Цикл

        Если НЕ Стр.Добавить Тогда
            Продолжить;
        КонецЕсли;

        Если НЕ ЗначениеЗаполнено(Стр.Сотрудник) Тогда
            Продолжить;
        КонецЕсли;

        Попытка

            ИнтеграцияAD.СинхронизироватьСотрудника(
                Стр.Сотрудник
            );

        Исключение

            Сообщить(
                "Ошибка: "
                + Стр.ЛогинAD
                + " / "
                + ОписаниеОшибки()
            );

        КонецПопытки;

    КонецЦикла;

КонецПроцедуры