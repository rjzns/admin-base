#Область СлужебныеПроцедурыИФункции
Функция V83ПодключитьБазу(ИнформационнаяБазаСсылка , СообщениеОбОшике) Экспорт
	
	Попытка
		Соединение = Новый COMObject("V83.COMConnector");
		СтруктураПодключения = Новый Структура("Сервер, База, Пользователь, Пароль");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ИнформационныеБазы.Сервер.Наименование КАК Сервер,
		|	ИнформационныеБазы.ПутьКБазе КАК База,
		|	""ext_exchange"" КАК Пользователь,
		|	""ext1_3exchange6"" КАК Пароль
		|ИЗ
		|	Справочник.ИнформационныеБазы КАК ИнформационныеБазы
		|ГДЕ
		|	ИнформационныеБазы.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ИнформационнаяБазаСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураПодключения,ВыборкаДетальныеЗаписи );
		Иначе
			СообщениеОбОшике = "Не найдены параметры для подключения к базе 1С: " + ИнформационнаяБазаСсылка.Наименование;
			БазаCom = Неопределено ;
			Возврат БазаCom;
		КонецЕсли;
		
		СтрокаПодключения = "Srvr = """ + СтруктураПодключения.Сервер + """; Ref = """ + СтруктураПодключения.База + 
		"""; Usr=""" + СтруктураПодключения.Пользователь +  """;Pwd=""" + СтруктураПодключения.Пароль + """";
		
		Попытка
			БазаCom = Соединение.Connect(СтрокаПодключения);			
		Исключение
			СообщениеОбОшике = "Ошибка подключения к базе 1С: " + ИнформационнаяБазаСсылка.Наименование + ". " +  ОписаниеОшибки();
			БазаCom = Неопределено ;
		КонецПопытки;
		
	Исключение
		СообщениеОбОшике = "Ошибка подключения к базе 1С: " + ИнформационнаяБазаСсылка.Наименование + ". " +  ОписаниеОшибки();
		БазаCom = Неопределено ;
	КонецПопытки;
	
	Возврат БазаCom;
	
КонецФункции // ()

#КонецОбласти